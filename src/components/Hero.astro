---
import NetworkBackground from "./NetworkBackground.astro";
import { site } from "../site.config";
import { withBase } from "../lib/url";

const initials = site.name
  .split(" ")
  .map((w) => w[0])
  .join("");
const links = site.links.filter((l) => l.href);
---

<header class="hero">
  <NetworkBackground />

  <div class="content">
    {
      site.photo ? (
        <img class="avatar" src={withBase(site.photo)} alt={`Portrait of ${site.name}`} width="184" height="184" />
      ) : (
        <div class="avatar" aria-hidden="true">{initials}</div>
      )
    }
    <h1>{site.name}</h1>
    <p class="role">{site.role}<br />{site.affiliationLine}</p>

    <ul class="affil" aria-label="Affiliations">
      {
        site.affiliations.map((a) => (
          <li>
            <a href={a.href} rel="noopener" title={a.name}>
              <img src={withBase(a.logo)} alt={a.name} style={`height:${a.height}px`} loading="eager" decoding="async" />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="pills">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
      {site.cv && <li><a class="primary" href={withBase(site.cv)} download>CV ↓</a></li>}
    </ul>
  </div>
</header>

<style>
  .hero { position: relative; text-align: center; padding: 72px 16px 40px; overflow: hidden; }
  .content { position: relative; z-index: 1; }
  ul { list-style: none; padding: 0; }

  .avatar {
    width: 184px; height: 184px; border-radius: 50%; margin: 0 auto 22px; object-fit: cover;
    border: 5px solid var(--bg); box-shadow: 0 0 0 2px var(--ink), 0 12px 30px rgb(0 0 0 / 18%);
    background: var(--line); display: grid; place-items: center;
    font: 800 52px var(--mono); color: var(--muted);
  }
  h1 { font-size: clamp(34px, 5.5vw, 54px); font-weight: 800; margin: 0; letter-spacing: -0.5px; line-height: 1.15; }
  .role { font: 400 17px/1.5 var(--mono); opacity: .85; margin: 12px auto 0; max-width: 760px; }

  /* Logos are designed for a light background, so the strip stays white in dark mode too. */
  .affil {
    display: inline-flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 14px 40px;
    margin: 30px auto 0; padding: 16px 32px; background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: 0 4px 18px rgb(0 0 0 / 5%);
  }
  .affil a { display: block; opacity: .92; transition: opacity .15s; }
  .affil a:hover { opacity: 1; }
  .affil img { width: auto; max-width: 100%; }

  .pills { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; }
  .pills a {
    font: 600 14px var(--mono); color: var(--ink); text-decoration: none;
    border: 1.5px solid var(--ink); border-radius: 999px; padding: 6px 16px; display: inline-block;
  }
  .pills a:hover, .pills a.primary { background: var(--ink); color: var(--bg); }

  @media (max-width: 760px) {
    .hero { padding-top: 48px; }
    .avatar { width: 140px; height: 140px; font-size: 40px; }
  }
</style>
