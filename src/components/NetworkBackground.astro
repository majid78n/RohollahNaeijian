---
// Decorative GNSS-style station network, rendered at build time (no client JS).
// A fixed seed keeps the pattern identical between builds.
const W = 1600;
const H = 700;
let seed = 7;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

const points = Array.from({ length: 140 }, () => [rnd() * W, rnd() * H] as const);

const ridges = Array.from({ length: 9 }, (_, k) => {
  const y0 = 180 + k * 60;
  let d = `M0 ${y0}`;
  for (let x = 0; x <= W; x += 40) {
    const y = y0 + Math.sin(x / 180 + k) * 40 + Math.sin(x / 67 + k * 2) * 14;
    d += ` L${x} ${y.toFixed(1)}`;
  }
  return d;
});

const edges: [number, number, number, number][] = [];
points.forEach((p, i) => {
  points
    .map((q, j) => [Math.hypot(p[0] - q[0], p[1] - q[1]), j] as const)
    .sort((a, b) => a[0] - b[0])
    .slice(1, 4)
    .forEach(([dist, j]) => {
      if (j > i && dist < 220) edges.push([p[0], p[1], points[j][0], points[j][1]]);
    });
});

const stations = points.map(([x, y]) => ({ x, y, r: 1.5 + rnd() * 2.5 }));
const r1 = (n: number) => n.toFixed(1);
---

<div class="hero-bg" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke="var(--net)" stroke-opacity=".12" stroke-width="1.2">
      {ridges.map((d) => <path d={d} />)}
    </g>
    <g stroke="var(--net)" stroke-opacity=".22">
      {edges.map(([x1, y1, x2, y2]) => <line x1={r1(x1)} y1={r1(y1)} x2={r1(x2)} y2={r1(y2)} />)}
    </g>
    <g fill="var(--net)">
      {stations.map((s) => <circle cx={r1(s.x)} cy={r1(s.y)} r={r1(s.r)} fill-opacity=".55" />)}
    </g>
    <g fill="none" stroke="var(--net)" stroke-opacity=".3">
      {stations.filter((s) => s.r > 3.6).map((s) => <circle cx={r1(s.x)} cy={r1(s.y)} r={r1(s.r + 5)} />)}
    </g>
  </svg>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, var(--sky2) 0%, var(--sky1) 45%, var(--bg) 100%);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 92%);
  }
</style>
