---
import Page from "../../layouts/Page.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<Page title="Projects" description="Research and engineering projects in GNSS geodesy, Earth observation and geospatial AI.">
  <div class="eyebrow">Things I've built</div>
  <h1>Projects</h1>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Page>

<style>
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; margin: 4px 0 28px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
</style>
